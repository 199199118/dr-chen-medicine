FaxaxsRc8JKXnUg\"\u003e\n\u003cmeta charset=\"utf-8\"\u003e \u003cmeta charset=\"utf-8\"\u003e\n\u003cdiv data-page-id=\"I0EYdj1eAozkSPxec5ccEcEjnUe\" data-lark-html-role=\"root\" data-docx-has-block-data=\"false\"\u003e\n\u003ch2 class=\"ace-line ace-line old-record-id-OsEHdQAiboZh6gxH2X3cPQjcnOl\"\u003e\u003cstrong\u003eHow It Works \u0026amp; Key Benefits\u003c\/strong\u003e\u003c\/h2\u003e\n\u003cdiv class=\"ace-line ace-line old-record-id-NYySdbuHMoofSyxcvmOcIh3inbg\"\u003eClinically crafted by dermatologists and freshly compounded for unmatched potency, this powerhouse Vitamin C duo:\u003c\/div\u003e\n\u003cul\u003e\n\u003cli style=\"font-weight: bold;\" class=\"ace-line ace-line old-record-id-Z8jUdgCJpoFM62xLSWgcdEUSnLK\"\u003e\u003cstrong\u003ePowerfully fades dullness, dark spots, and stubborn hyperpigmentation\u003c\/strong\u003e\u003c\/li\u003e\n\u003cli style=\"font-weight: bold;\" class=\"ace-line ace-line old-record-id-Rm9Wd655Tob6XNxRKtwczmwrnJf\"\u003e\u003cstrong\u003eTargets multiple skin concerns — including age spots, sun spots, melasma, and uneven pigmentation\u003c\/strong\u003e\u003c\/li\u003e\n\u003cli style=\"font-weight: bold;\" class=\"ace-line ace-line old-record-id-UbWFd9HxEoS2w8xWkEXcD6tlnSc\"\u003e\u003cstrong\u003eDermatologist-formulated with prescription-grade ingredients and freshly compounded for maximum potency.\u003c\/strong\u003e\u003c\/li\u003e\n\u003cli style=\"font-weight: bold;\" class=\"ace-line ace-line old-record-id-P7sYdnlCBotmJ0x2aEAchUxtnzh\"\u003e\u003cstrong\u003eHelps prevent melanin buildup, calms inflammation, and improves skin structure for a clearer, healthier look.\u003c\/strong\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cdiv class=\"ace-line ace-line old-record-id-LKqUdHg5so6CRbxHqjNcqC4Znif\"\u003eFrom dark spots and melasma to acanthosis nigricans and uneven body tone — no pigment stands a chance. Use it anywhere you see dullness or discoloration. Face to body, your glow gets a full upgrade.\u003c\/div\u003e\n\u003c\/div\u003e\n\u003cspan data-lark-record-data='{\"isCut\":false,\"rootId\":\"I0EYdj1eAozkSPxec5ccEcEjnUe\",\"parentId\":\"I0EYdj1eAozkSPxec5ccEcEjnUe\",\"blockIds\":[83,81,79,77,75,73,71],\"recordIds\":[\"OsEHdQAiboZh6gxH2X3cPQjcnOl\",\"NYySdbuHMoofSyxcvmOcIh3inbg\",\"Z8jUdgCJpoFM62xLSWgcdEUSnLK\",\"Rm9Wd655Tob6XNxRKtwczmwrnJf\",\"UbWFd9HxEoS2w8xWkEXcD6tlnSc\",\"P7sYdnlCBotmJ0x2aEAchUxtnzh\",\"LKqUdHg5so6CRbxHqjNcqC4Znif\"],\"recordMap\":{\"LKqUdHg5so6CRbxHqjNcqC4Znif\":{\"id\":\"LKqUdHg5so6CRbxHqjNcqC4Znif\",\"snapshot\":{\"type\":\"text\",\"children\":[],\"comments\":[],\"revisions\":[],\"author\":\"7501700203293016066\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"From dark spots and melasma to acanthosis nigricans and uneven body tone — no pigment stands a chance. Use it anywhere you see dullness or discoloration. Face to body, your glow gets a full upgrade.\"},\"attribs\":{\"0\":\"*0+5i\"}},\"apool\":{\"numToAttrib\":{\"0\":[\"author\",\"7501700203293016066\"]},\"nextNum\":1}},\"folded\":false,\"parent_id\":\"I0EYdj1eAozkSPxec5ccEcEjnUe\"}},\"P7sYdnlCBotmJ0x2aEAchUxtnzh\":{\"id\":\"P7sYdnlCBotmJ0x2aEAchUxtnzh\",\"snapshot\":{\"type\":\"text\",\"children\":[],\"comments\":[],\"revisions\":[],\"author\":\"7501700203293016066\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"·Helps prevent melanin buildup, calms inflammation, and improves skin structure for a clearer, healthier look.\"},\"attribs\":{\"0\":\"*0+32\"}},\"apool\":{\"numToAttrib\":{\"0\":[\"author\",\"7501700203293016066\"]},\"nextNum\":1}},\"folded\":false,\"parent_id\":\"I0EYdj1eAozkSPxec5ccEcEjnUe\"}},\"UbWFd9HxEoS2w8xWkEXcD6tlnSc\":{\"id\":\"UbWFd9HxEoS2w8xWkEXcD6tlnSc\",\"snapshot\":{\"type\":\"text\",\"children\":[],\"comments\":[],\"revisions\":[],\"author\":\"7501700203293016066\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"·Dermatologist-formulated with prescription-grade ingredients and freshly compounded for maximum potency.\"},\"attribs\":{\"0\":\"*0+2x\"}},\"apool\":{\"numToAttrib\":{\"0\":[\"author\",\"7501700203293016066\"]},\"nextNum\":1}},\"folded\":false,\"parent_id\":\"I0EYdj1eAozkSPxec5ccEcEjnUe\"}},\"Rm9Wd655Tob6XNxRKtwczmwrnJf\":{\"id\":\"Rm9Wd655Tob6XNxRKtwczmwrnJf\",\"snapshot\":{\"type\":\"text\",\"children\":[],\"comments\":[],\"revisions\":[],\"author\":\"7501700203293016066\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"·Targets multiple skin concerns — including age spots, sun spots, melasma, and uneven pigmentation\"},\"attribs\":{\"0\":\"*0+2q\"}},\"apool\":{\"numToAttrib\":{\"0\":[\"author\",\"7501700203293016066\"]},\"nextNum\":1}},\"folded\":false,\"parent_id\":\"I0EYdj1eAozkSPxec5ccEcEjnUe\"}},\"Z8jUdgCJpoFM62xLSWgcdEUSnLK\":{\"id\":\"Z8jUdgCJpoFM62xLSWgcdEUSnLK\",\"snapshot\":{\"type\":\"text\",\"children\":[],\"comments\":[],\"revisions\":[],\"author\":\"7501700203293016066\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"·Powerfully fades dullness, dark spots, and stubborn hyperpigmentation\"},\"attribs\":{\"0\":\"*0+1y\"}},\"apool\":{\"numToAttrib\":{\"0\":[\"author\",\"7501700203293016066\"]},\"nextNum\":1}},\"folded\":false,\"parent_id\":\"I0EYdj1eAozkSPxec5ccEcEjnUe\"}},\"NYySdbuHMoofSyxcvmOcIh3inbg\":{\"id\":\"NYySdbuHMoofSyxcvmOcIh3inbg\",\"snapshot\":{\"type\":\"text\",\"children\":[],\"comments\":[],\"revisions\":[],\"author\":\"7501700203293016066\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"Clinically crafted by dermatologists and freshly compounded for unmatched potency, this powerhouse Vitamin C duo:\"},\"attribs\":{\"0\":\"*0+35\"}},\"apool\":{\"numToAttrib\":{\"0\":[\"author\",\"7501700203293016066\"]},\"nextNum\":1}},\"folded\":false,\"parent_id\":\"I0EYdj1eAozkSPxec5ccEcEjnUe\"}},\"OsEHdQAiboZh6gxH2X3cPQjcnOl\":{\"id\":\"OsEHdQAiboZh6gxH2X3cPQjcnOl\",\"snapshot\":{\"type\":\"text\",\"children\":[],\"comments\":[],\"revisions\":[],\"author\":\"7501700203293016066\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"How It Works \u